---
import BaseLayout from '../layouts/BaseLayout.astro';

const fundingConfig = {
  totalRaised: 2500,
  milestones: [
    { amount: 2500, label: 'Competition Robot' },
    { amount: 4500, label: 'First International Competition' },
    { amount: 6500, label: 'International Advancement Reserve' },
    { amount: 7500, label: 'Prototyping & Manufacturing' },
    { amount: 8500, label: 'Outreach & Team Infrastructure' },
    { amount: 10000, label: 'Fully Funded 2026/27 Season' },
    { amount: 12500, label: 'FTC Training Field' },
    { amount: 15000, label: 'R&D & Future Engineering Projects' },
    { amount: 20000, label: 'Long-Term Team Development' },
  ]
};

const milestoneState = (() => {
  const milestones = fundingConfig.milestones;
  const totalRaised = fundingConfig.totalRaised;
  const latestCompleted = [...milestones]
    .reverse()
    .find(milestone => totalRaised >= milestone.amount);

  const nextMilestone = milestones.find(milestone => totalRaised < milestone.amount) ?? milestones[milestones.length - 1];
  const previousMilestone = [...milestones]
    .reverse()
    .find(milestone => milestone.amount < nextMilestone.amount) ?? { amount: 0, label: 'Start' };

  const rangeStart = previousMilestone.amount;
  const rangeEnd = nextMilestone.amount;
  const interval = Math.max(rangeEnd - rangeStart, 1);
  const progress = totalRaised >= rangeEnd
    ? 100
    : Math.max(0, Math.min(100, ((totalRaised - rangeStart) / interval) * 100));

  const isCompleted = totalRaised >= milestones[milestones.length - 1].amount;

  return {
    totalRaised,
    milestones,
    latestCompleted,
    nextMilestone,
    previousMilestone,
    rangeStart,
    rangeEnd,
    progress,
    isCompleted,
  };
})();
---

<BaseLayout
  title="Donate"
  description="Support Heroes of the Sea — your donation funds the robot, the competitions, and the community work that makes this team more than just robotics."
>

  <div class="page-hero">
    <div class="container">
      <span class="section-label" data-i18n="donate.sectionLabel">Support the team</span>
      <h1 data-i18n="donate.title">Help us compete &amp; grow</h1>
      <p style="max-width: 52ch; color: rgba(242,242,242,0.72); margin-top: 1rem; font-size: 1.0625rem;" data-i18n="donate.subtitle">
        Heroes of the Sea runs entirely on the support of people who believe in what
        student-led robotics can do. Every donation goes directly to the team.
      </p>
    </div>
  </div>

  <section class="donate-powers" aria-labelledby="powers-heading">
    <div class="container">

      <div class="donate-powers-lead">
        <span class="section-label" data-i18n="donate.powersLabel">Where your money goes</span>
        <h2 id="powers-heading" data-i18n="donate.powersTitle">What you're powering</h2>
        <p data-i18n="donate.powersIntro">
          Building a competitive FTC robot — and getting it to the world stage — takes
          real resources. Here's exactly what your contribution fuels.
        </p>
      </div>

      <div class="powers-grid" role="list">

        <div class="power-card" role="listitem">
          <div class="power-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/>
            </svg>
          </div>
          <h3 class="power-title" data-i18n="donate.robotConstruction">Robot Construction</h3>
          <p class="power-desc" data-i18n="donate.robotConstructionDesc">
            Custom drive trains, precision actuators, sensors, wiring harnesses, and
            structural materials. A competition-ready FTC robot is rebuilt from scratch
            every season.
          </p>
        </div>

        <div class="power-card" role="listitem">
          <div class="power-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 21h8M12 17v4M17 3H7l1 9a4 4 0 0 0 8 0l1-9Z"/>
              <path d="M7 4H4a2 2 0 0 0 0 4h3M17 4h3a2 2 0 0 1 0 4h-3"/>
            </svg>
          </div>
          <h3 class="power-title" data-i18n="donate.competitionEntry">Competition Entry</h3>
          <p class="power-desc" data-i18n="donate.competitionEntryDesc">
            Registration fees for regional qualifiers and state championship events.
            Each competition is a chance to measure our progress and push further.
          </p>
        </div>

        <div class="power-card" role="listitem">
          <div class="power-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <h3 class="power-title" data-i18n="donate.travel">Travel &amp; Logistics</h3>
          <p class="power-desc" data-i18n="donate.travelDesc">
            Getting the full team — and the robot — to competition venues safely.
            Without travel support, we can't compete beyond our local region.
          </p>
        </div>

        <div class="power-card" role="listitem">
          <div class="power-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3 class="power-title" data-i18n="donate.outreach">Outreach &amp; Education</h3>
          <p class="power-desc" data-i18n="donate.outreachDesc">
            Community workshops, school demos, and events that bring robotics to
            students who've never had the chance to build something — yet.
          </p>
        </div>

      </div>
    </div>
  </section>

  <section class="support-campaign-section" aria-labelledby="why-support-heading">
    <div class="container">
      <div class="support-campaign-intro">
        <span class="section-label" data-i18n="donate.whySupportLabel">Why support us</span>
        <h2 id="why-support-heading" data-i18n="donate.whySupportTitle">We’ve already shown what we can do with nine days. Now we want to see what we can do with a full season.</h2>
      </div>

      <p class="support-campaign-lead" data-i18n="donate.whySupportLead1">
        Heroes of the Sea started in 2026 as one of Portugal’s first FIRST Tech Challenge teams.
        With only nine days to design, build and program our first competition robot, we entered the
        Lisbon Scrimmage, became Alliance Captains, and received the Sustainability Award.
      </p>

      <p class="support-campaign-lead" data-i18n="donate.whySupportLead2">
        Today, we are a team of around 15 students, working across hardware, software, CAD and
        outreach, with ambitions that go beyond a single robot or competition.
      </p>

      <div class="support-values-grid" role="list" aria-label="Reasons to support the team">
        <article class="support-value-card" role="listitem">
          <h3 data-i18n="donate.build">BUILD</h3>
          <p data-i18n="donate.buildDesc">Turn designs into real competition robots through hardware, electronics, materials and manufacturing.</p>
        </article>

        <article class="support-value-card" role="listitem">
          <h3 data-i18n="donate.compete">COMPETE</h3>
          <p data-i18n="donate.competeDesc">Take our team and our robots beyond Portugal and compete internationally.</p>
        </article>

        <article class="support-value-card" role="listitem">
          <h3 data-i18n="donate.learn">LEARN</h3>
          <p data-i18n="donate.learnDesc">Give students the opportunity to solve real engineering problems through design, programming, manufacturing and iteration.</p>
        </article>

        <article class="support-value-card" role="listitem">
          <h3 data-i18n="donate.grow">GROW</h3>
          <p data-i18n="donate.growDesc">Develop new projects, expand STEM outreach and help build a stronger FIRST community in Portugal.</p>
        </article>
      </div>

      <p class="support-campaign-quote" data-i18n="donate.quote">
        You’re not just funding a robot. You’re giving us the resources to build, compete, experiment and create what comes next.
      </p>

      <div class="support-campaign-links">
        <a href="#our-next-goal-heading" class="support-campaign-link" data-i18n="donate.nextGoalLink">→ See our next goal</a>
        <a href="#for-partners" class="support-campaign-link" data-i18n="donate.partnerLink">→ Become a partner</a>
      </div>
    </div>
  </section>

  <section id="for-partners" class="partners-section" aria-labelledby="for-partners-heading">
    <div class="container">
      <div class="donate-powers-lead">
        <span class="section-label" data-i18n="donate.forPartnersLabel">For Partners</span>
        <h2 id="for-partners-heading" data-i18n="donate.forPartnersTitle">What companies and organisations receive in return</h2>
        <p data-i18n="donate.forPartnersIntro">
          We believe the strongest partnerships are built on shared purpose. By supporting Heroes of the Sea,
          partners help us grow while gaining meaningful visibility and a chance to invest in the next generation of innovators.
        </p>
      </div>

      <div class="partners-grid">
        <div class="partner-item">
          <strong data-i18n="donate.visibility">Visibility</strong>
          <p data-i18n="donate.visibilityDesc">Recognition on the robot, team clothing, competition materials, online channels and event presence.</p>
        </div>

        <div class="partner-item">
          <strong data-i18n="donate.communityImpact">Community impact</strong>
          <p data-i18n="donate.communityImpactDesc">Support STEM education, outreach activities and the development of a stronger robotics culture in Portugal.</p>
        </div>

        <div class="partner-item">
          <strong data-i18n="donate.talentPipeline">Talent pipeline</strong>
          <p data-i18n="donate.talentPipelineDesc">Connect with motivated students and early-career engineers who are building practical technical skills every day.</p>
        </div>

        <div class="partner-item">
          <strong data-i18n="donate.sharedMission">Shared mission</strong>
          <p data-i18n="donate.sharedMissionDesc">Back a team that values creativity, teamwork, problem-solving and the future of engineering in Portugal.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="funding-goal-section" aria-labelledby="our-next-goal-heading">
    <div class="container">
      <div class="funding-goal-card">
        <div class="funding-goal-header">
          <span class="section-label" data-i18n="donate.goalSectionLabel">Our Next Goal</span>
          <h2 id="our-next-goal-heading" data-i18n="donate.goalTitle">€2,500 goal reached!</h2>
        </div>

        <div class="funding-goal-amounts" aria-live="polite">
          <span>€{milestoneState.totalRaised.toLocaleString()} / €{milestoneState.nextMilestone.amount.toLocaleString()}</span>
        </div>

        <div class="funding-goal-progress" aria-label="Progress toward the current milestone" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.round(milestoneState.progress)}>
          <span style={{ width: `${milestoneState.progress}%` }}></span>
        </div>

        <div class="funding-goal-status">
          {milestoneState.isCompleted ? (
            <p><strong>Fully funded.</strong> We have reached the long-term goal.</p>
          ) : (
            <>
              {milestoneState.latestCompleted ? (
                <p><strong>Latest completed:</strong> €{milestoneState.latestCompleted.amount.toLocaleString()} — {milestoneState.latestCompleted.label} ✓</p>
              ) : (
                <p><strong>Latest completed:</strong> No milestone reached yet.</p>
              )}
              <p><strong>Next goal:</strong> €{milestoneState.nextMilestone.amount.toLocaleString()} — {milestoneState.nextMilestone.label}</p>
            </>
          )}
        </div>

        <p class="funding-goal-copy" data-i18n="donate.goalCopy">
          Thank you for helping us fund our BIOBUZZ competition robot. Our next milestone is preparing for our first international competition.
        </p>

        <a href="https://forms.cloud.microsoft/e/j9KJUpUVYC" target="_blank" rel="noopener noreferrer" class="btn-secondary funding-goal-button" data-i18n="donate.ctaTalk">Let’s talk!</a>
      </div>
    </div>
  </section>


</BaseLayout>
