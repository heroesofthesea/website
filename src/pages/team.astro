---
import BaseLayout from '../layouts/BaseLayout.astro';
import teamData from '../data/team.json';

interface Member {
  name: string;
  pronouns?: string;
  role: string;
  bio: string;
  photo?: string;
}

const members = teamData.members as Member[];
const departments = [
  { key: 'leadership', label: 'Leadership', memberNames: ['Martim Glória', 'Pedro Dias'] },
  { key: 'hardware', label: 'Hardware', memberNames: ['Lourenço Freire', 'Filipe Jorge', 'Pedro Albernaz'] },
  { key: 'software', label: 'Software', memberNames: ['Bruna Rung', 'Guilherme Albernaz'] },
  { key: 'outreach', label: 'Outreach', memberNames: ['Dinis Carvalho'] },
  { key: 'socialMedia', label: 'Social Media', memberNames: ['Alejandro Reyes', 'Nuno Araújo'] },
  { key: 'mentorship', label: 'Mentorship', memberNames: ['Beatriz Sousa'] },
];

const portugueseTeamCopy: Record<string, { role: string; bio: string }> = {
  'Pedro Dias': {
    role: 'Lead Coach',
    bio: 'Entre experiências de física, programação e robótica, Pedro traz a sala de aula para a oficina. Como professor de Física, Química e Informática, incentiva os estudantes a desmontar, questionar e descobrir como a tecnologia funciona na prática.',
  },
  'Martim Glória': {
    role: 'Team Captain',
    bio: 'Os interesses de Martim vão da informática e física à psicologia e literatura. Como capitão da equipa, combina o fascínio pela tecnologia com o desafio de liderar uma equipa internacional de robótica e transformar projetos ambiciosos dos estudantes em realidade.',
  },
  'Lourenço Freire': {
    role: 'Hardware Lead & Developer',
    bio: 'Artista, cosplayer e programador, Lourenço transita naturalmente entre o design digital e a fabricação física. Quer esteja a criar algo para um fato ou a trabalhar num robô, aborda a engenharia com a imaginação de um artista e a mentalidade de um criador.',
  },
  'Filipe Jorge': {
    role: 'Hardware',
    bio: 'O Filipe gosta mais de tecnologia quando pode trabalhar diretamente com ela. Em vez de depender de equipamento elaborado, gosta de experimentar com o que tem à disposição, improvisar soluções e encontrar formas engenhosas de fazer as coisas funcionar.',
  },
  'Pedro Albernaz': {
    role: 'Hardware Developer',
    bio: 'Com um forte interesse por Física e Química, Pedro gosta de ligar princípios científicos a desafios reais de engenharia. Interessa-se especialmente por perceber porque é que as coisas se comportam de determinada forma e como usar esse conhecimento para criar melhores soluções.',
  },
  'Bruna Rung': {
    role: 'Software Lead & Developer',
    bio: 'Para Bruna, programar é onde a lógica se encontra com a criatividade. Com interesses que abrangem o desenvolvimento de software e a música, gosta de explorar como código cuidadosamente estruturado transforma uma ideia em algo que funciona no mundo real.',
  },
  'Guilherme Albernaz': {
    role: 'Software Developer',
    bio: 'Guilherme sente-se atraído pelo lado matemático da informática, sobretudo pela lógica dos algoritmos e dos sistemas complexos. Gosta de perceber como decompor problemas em etapas precisas e transformá-las em software funcional.',
  },
  'Dinis Carvalho': {
    role: 'Outreach',
    bio: 'O Dinis tem interesses variados, da aviação e desportos radicais à tecnologia e à guitarra. Na divulgação, leva o entusiasmo por diferentes áreas para conversas com pessoas e organizações, ajudando a apresentar-lhes os projetos da equipa.',
  },
  'Alejandro Reyes': {
    role: 'Social Media',
    bio: 'Guitarrista com um forte lado criativo, Alejandro traz para a equipa o seu interesse pela música e pela expressão visual. Gosta de experimentar ideias e de encontrar formas envolventes de partilhar a personalidade e os projetos do Heroes of the Sea.',
  },
  'Nuno Araújo': {
    role: 'Social Media',
    bio: 'A música ocupa um lugar importante no mundo do Nuno, desde explorar diferentes géneros a descobrir novos artistas. Leva esse interesse por estilos e perspetivas diferentes para as redes sociais da equipa, ajudando a comunicar o que acontece para além do campo de competição.',
  },
  'Beatriz Sousa': {
    role: 'External Mentor',
    bio: 'Antiga aluna do Colégio Atlântico e atual estudante de Informática na NOVA FCT, Beatriz partilha a sua experiência com a próxima geração. Tendo participado no Astronauta por um Dia, sabe que as oportunidades para explorar a ciência podem ir muito além da sala de aula.',
  },
};

const departmentPt: Record<string, string> = {
  leadership: 'Liderança',
  hardware: 'Hardware',
  software: 'Software',
  outreach: 'Divulgação',
  socialMedia: 'Redes sociais',
  mentorship: 'Mentoria',
};

function getInitials(name: string): string {
  return name.split(' ').filter(Boolean).map(part => part[0]).slice(0, 2).join('').toUpperCase();
}
---

<BaseLayout
  title="Team"
  description="Meet the students and mentors of Heroes of the Sea — FTC Team #34200 from Portugal."
>
  <div class="page-hero team-page-hero">
    <div class="container">
      <span class="section-label" data-i18n="team.label">The people behind the robot</span>
      <h1 data-i18n="team.title">Meet the team</h1>
    </div>
  </div>

  <section class="section section--tight team-directory" aria-label="Team members">
    <div class="container">
      {departments.map((department) => {
        const departmentMembers = department.memberNames
          .map(name => members.find(member => member.name === name))
          .filter((member): member is Member => Boolean(member));

        return (
          <section class="team-department" aria-labelledby={`department-${department.key}`}>
            <h2
              class="visually-hidden"
              id={`department-${department.key}`}
              data-department-title
              data-title-en={department.label}
              data-title-pt={departmentPt[department.key]}
            >{department.label}</h2>

            <div class="member-grid" role="list" aria-label={department.label}>
              {departmentMembers.map(member => {
                const pt = portugueseTeamCopy[member.name];
                return (
                  <article class="member-card" role="listitem" aria-label={`${member.name}, ${member.role}`}>
                    <div class="member-card-top">
                      <div class="member-photo-wrap">
                        {member.photo ? (
                          <img src={member.photo} alt={`Photo of ${member.name}`} width="88" height="88" loading="lazy" decoding="async" />
                        ) : (
                          <div class="member-initials" aria-label={`Initials for ${member.name}`}>{getInitials(member.name)}</div>
                        )}
                      </div>
                      <div class="member-heading-copy">
                        <div class="member-name-line">
                          <h3 class="member-name">{member.name}</h3>
                          {member.pronouns && <span class="member-pronouns">{member.pronouns}</span>}
                        </div>
                        <p class="member-role" data-team-role data-role-en={member.role} data-role-pt={pt?.role ?? member.role}>{member.role}</p>
                      </div>
                    </div>
                    <p class="member-bio" data-team-bio data-bio-en={member.bio} data-bio-pt={pt?.bio ?? member.bio}>{member.bio}</p>
                  </article>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </section>

  <script>
    const updateTeamLanguage = () => {
      const lang = document.documentElement.lang === 'pt' ? 'pt' : 'en';

      document.querySelectorAll<HTMLElement>('[data-team-role]').forEach((element) => {
        element.textContent = lang === 'pt' ? element.dataset.rolePt ?? element.dataset.roleEn ?? '' : element.dataset.roleEn ?? '';
      });
      document.querySelectorAll<HTMLElement>('[data-team-bio]').forEach((element) => {
        element.textContent = lang === 'pt' ? element.dataset.bioPt ?? element.dataset.bioEn ?? '' : element.dataset.bioEn ?? '';
      });
      document.querySelectorAll<HTMLElement>('[data-department-title]').forEach((element) => {
        element.textContent = lang === 'pt' ? element.dataset.titlePt ?? element.dataset.titleEn ?? '' : element.dataset.titleEn ?? '';
      });
    };

    document.addEventListener('site-language-change', updateTeamLanguage);
    updateTeamLanguage();
  </script>
</BaseLayout>