---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sponsors"
  description="Supporters and partners of Heroes of the Sea — FIRST Tech Challenge team #34200."
>
  <div class="page-hero">
    <div class="container">
      <span class="section-label" data-i18n="sponsors.label">Our supporters</span>
      <h1 data-i18n="sponsors.title">Sponsors</h1>
    </div>
  </div>

  <section class="section section--tight" aria-labelledby="sponsors-heading">
    <div class="container">
      <div class="sponsors-intro">
        <h2 id="sponsors-heading" data-i18n="sponsors.introHeading">Partners helping us grow</h2>
        <p data-i18n="sponsors.introText">
          We are grateful to the organisations and institutions supporting Heroes of the Sea and helping us build,
          compete, and inspire new generations of engineers and problem-solvers.
        </p>
      </div>

      <div class="sponsors-grid">
        <div class="sponsor-card">
          <img src="/images/colegioatlantico.png" alt="Colégio Atlântico" loading="lazy" />
        </div>

        <div class="sponsor-card">
          <img src="/images/raisebox.png" alt="RaiseBox" loading="lazy" />
        </div>

        <div class="sponsor-card">
          <img src="/images/automatication_logo.png" alt="Automatication, custom development for publishing" loading="lazy" />
        </div>

        <div class="sponsor-card">
          <img src="/images/paradigmoriginal.png" alt="Paradigm Original" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="sponsor-tiers-heading">
    <div class="container">
      <div class="sponsors-intro">
        <h2 id="sponsor-tiers-heading" data-i18n="sponsors.tiersTitle">Sponsorship levels</h2>
        <p data-i18n="sponsors.tiersIntro">Recognition and visibility scale with the sponsorship level.</p>
      </div>

      <div class="partners-grid" role="list" aria-label="Sponsorship contribution levels">
        <article class="partner-item" role="listitem">
          <strong data-i18n="sponsors.supporterTier">Supporter</strong>
          <p data-i18n="sponsors.supporterThreshold">Minimum contribution: €250</p>
        </article>

        <article class="partner-item" role="listitem">
          <strong data-i18n="sponsors.bronzeTier">Bronze</strong>
          <p data-i18n="sponsors.bronzeThreshold">Minimum contribution: €1,000</p>
        </article>

        <article class="partner-item" role="listitem">
          <strong data-i18n="sponsors.silverTier">Silver</strong>
          <p data-i18n="sponsors.silverThreshold">Minimum contribution: €2,000</p>
        </article>

        <article class="partner-item" role="listitem">
          <strong data-i18n="sponsors.goldTier">Gold</strong>
          <p data-i18n="sponsors.goldThreshold">Minimum contribution: €3,500+</p>
        </article>

        <article class="partner-item" role="listitem">
          <strong data-i18n="sponsors.diamondTier">Diamond</strong>
          <p data-i18n="sponsors.diamondThreshold">Minimum contribution: €5,000</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
