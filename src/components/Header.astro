  const applyLanguage = (lang: 'en' | 'pt') => {
    document.documentElement.lang = lang;
    document.body.dataset.lang = lang;

    document.querySelectorAll('[data-i18n]').forEach((element) => {
      const key = element.getAttribute('data-i18n');
      const nextText = key ? translations[lang][key] : null;
      if (nextText) {
        const formatted = nextText.includes('{year}')
          ? nextText.replace('{year}', String(new Date().getFullYear()))
          : nextText;
        element.textContent = formatted;
      }
    });

    document.dispatchEvent(new CustomEvent('site-language-change', { detail: { lang } }));

    if (langButton) {
      const isPortuguese = lang === 'pt';
      langButton.textContent = isPortuguese ? 'EN' : 'PT';
      langButton.setAttribute('aria-label', isPortuguese ? 'Switch to English' : 'Switch to Portuguese');
      langButton.setAttribute('title', isPortuguese ? 'Switch to English' : 'Switch to Portuguese');
    }
  };

  const savedLang = localStorage.getItem('site-language');
  const initialLang = savedLang === 'en' ? 'en' : 'pt';
  applyLanguage(initialLang);

  langButton?.addEventListener('click', () => {
    const nextLang = document.documentElement.lang === 'pt' ? 'en' : 'pt';
    localStorage.setItem('site-language', nextLang);
    applyLanguage(nextLang);
  });

  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav.classList.toggle('is-open', !open);
  });

  nav.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    toggle.setAttribute('aria-expanded', 'false');
    nav.classList.remove('is-open');
  }));

  document.addEventListener('click', e => {
    if (!header.contains(e.target as Node)) {
      toggle.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
    }
  });

  const sentinel = document.createElement('div');
  sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:1px;pointer-events:none;';
  document.body.prepend(sentinel);
  new IntersectionObserver(
    ([e]) => header.classList.toggle('scrolled', !e.isIntersecting),
    { rootMargin: '-1px 0px 0px 0px', threshold: 1 }
  ).observe(sentinel);
</script>
