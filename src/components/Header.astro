---
const navLinks = [
  { href: '/',       label: 'Home', labelPt: 'Início' },
  { href: '/team',   label: 'Team', labelPt: 'Equipa' },
  { href: '/blog',   label: 'Blog', labelPt: 'Blog' },
  { href: '/sponsors', label: 'Sponsors', labelPt: 'Patrocinadores' },
];

const { pathname } = Astro.url;
---

<a class="skip-link" href="#main-content">Skip to main content</a>

<header class="site-header" id="site-header" role="banner">
  <a href="/" class="site-logo" aria-label="Heroes of the Sea — home">
    <img
      src="/images/logo_horizontal_variant2_nobg.svg"
      alt="Heroes of the Sea"
      class="site-logo-img"
      width="160"
      height="71"
    />
  </a>
  <button
    class="nav-toggle"
    aria-expanded="false"
    aria-controls="main-nav"
    aria-label="Toggle navigation menu"
  >
    <span class="bar" aria-hidden="true"></span>
    <span class="bar" aria-hidden="true"></span>
    <span class="bar" aria-hidden="true"></span>
  </button>

  <nav id="main-nav" class="main-nav" aria-label="Main navigation">
    {navLinks.map(link => (
      <a
        href={link.href}
        aria-current={pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href)) ? 'page' : undefined}
        data-i18n={pathname.startsWith(link.href) ? `nav.${link.href.replace('/', '') || 'home'}` : `nav.${link.href.replace('/', '') || 'home'}`}
      >
        {link.label}
      </a>
    ))}
    <button
      type="button"
      class="lang-switch"
      data-lang-toggle
      aria-label="Switch to Portuguese"
      title="Switch to Portuguese"
    >
      PT
    </button>
    <a href="/donate" class="nav-donate" aria-current={pathname === '/donate' ? 'page' : undefined} data-i18n="nav.donate">
      Donate
    </a>
  </nav>
</header>

